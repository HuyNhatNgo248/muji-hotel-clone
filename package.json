{
  "name": "muji-hotel",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "vercel-blob:update": "node ./src/scripts/update-vercel-blob.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.6",
    "@payloadcms/db-mongodb": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/payload-cloud": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.15.0",
    "lucide-react": "^1.77.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "payload": "3.94.1",
    "postcss": "^8.5.33",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-icons": "^5.7.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
